    <string name="onb_copy_pubkey">Public Key kopieren</string>
    <string name="onb_agent_key_label">SSH-Schlüssel des Agents auf dem Gerät</string>
    <string name="onb_build">Build %1$s (%2$d)</string>
    <string name="onb_confirm_body">Stackward hängt den öffentlichen Schlüssel dieses Geräts an ~/.ssh/authorized_keys von %1$s an und installiert das schreibgeschützte Prüfskript in ~/.stackward/. Es wird kein root benötigt.</string>
